{
  "schema": 1,
  "_comment": "Stage prototypes. A workflow stage names one of these in `prototype` and overrides only what differs. `qvasp` is the command that writes the INCAR/KPOINTS for the stage; `overrides` are appended to that INCAR; `requires` are files that must be present before the stage starts; `produces` are the files the next stage may consume; `gate` is the acceptance test run when the job ends.",
  "prototypes": {
    "relax": {
      "kind": "calc",
      "qvasp": "-relax",
      "kpoints": "-k 0.03",
      "overrides": {
        "ISIF": 3,
        "EDIFFG": -0.01,
        "NSW": 200,
        "IBRION": 2,
        "ENCUT": 500
      },
      "requires": [
        "POSCAR",
        "POTCAR"
      ],
      "produces": [
        "CONTCAR",
        "OUTCAR"
      ],
      "gate": {
        "type": "ionic_converged"
      },
      "note": "ISIF=3 is right for a bulk cell and wrong for a slab or a molecule: the vacuum direction must stay fixed (use ISIF=2 there)."
    },
    "scf": {
      "kind": "calc",
      "qvasp": "-scf",
      "kpoints": "-k 0.03",
      "overrides": {
        "LCHARG": true,
        "LWAVE": true,
        "EDIFF": "1E-6",
        "ENCUT": 500
      },
      "requires": [
        "POSCAR",
        "POTCAR"
      ],
      "produces": [
        "CHGCAR",
        "WAVECAR",
        "OUTCAR"
      ],
      "gate": {
        "type": "scf_converged"
      },
      "note": "Produces the charge density every non-self-consistent step reuses."
    },
    "nscf": {
      "kind": "calc",
      "qvasp": "-band",
      "kpoints": "-k 0.02",
      "overrides": {
        "ICHARG": 11,
        "ENCUT": 500,
        "LORBIT": 10,
        "LWAVE": false,
        "LCHARG": false
      },
      "requires": [
        "POSCAR",
        "POTCAR",
        "CHGCAR"
      ],
      "produces": [
        "EIGENVAL",
        "OUTCAR",
        "PROCAR"
      ],
      "gate": {
        "type": "file_present",
        "file": "EIGENVAL"
      },
      "note": "ICHARG=11 reads CHGCAR and never updates it. Requires a converged SCF density, and ENCUT must equal the SCF value: VASP rebuilds its FFT grid from ENCUT, and a different grid makes it refuse the file with 'dimensions on CHGCAR file are different'."
    },
    "hybrid": {
      "kind": "calc",
      "qvasp": "-hse",
      "kpoints": "-k 0.03",
      "overrides": {
        "LHFCALC": true,
        "HFSCREEN": 0.2,
        "AEXX": 0.25,
        "LORBIT": 11,
        "ALGO": "Damped"
      },
      "requires": [
        "POSCAR",
        "POTCAR"
      ],
      "produces": [
        "EIGENVAL",
        "OUTCAR"
      ],
      "gate": {
        "type": "file_present",
        "file": "EIGENVAL"
      },
      "note": "HSE06 is screened (HFSCREEN=0.2), so HFRCUT is not needed. ALGO=Damped is the only stable choice for hybrids."
    },
    "dfpt": {
      "kind": "calc",
      "qvasp": "-freq",
      "kpoints": "-k 0.03",
      "overrides": {
        "IBRION": 5,
        "NFREE": 2,
        "POTIM": 0.015,
        "ISYM": 0,
        "EDIFF": "1E-6"
      },
      "requires": [
        "POSCAR",
        "POTCAR"
      ],
      "produces": [
        "OUTCAR",
        "DYNMAT"
      ],
      "gate": {
        "type": "file_present",
        "file": "OUTCAR"
      },
      "note": "Finite displacement. POTIM=0.015 A is the displacement amplitude for IBRION=5/6, not a time step."
    },
    "elastic": {
      "kind": "calc",
      "qvasp": "-elastic",
      "kpoints": "-k 0.02",
      "overrides": {
        "IBRION": 6,
        "ISIF": 3,
        "NFREE": 4,
        "ENCUT": 1000
      },
      "requires": [
        "POSCAR",
        "POTCAR"
      ],
      "produces": [
        "OUTCAR"
      ],
      "gate": {
        "type": "file_present",
        "file": "OUTCAR"
      },
      "note": "Elastic constants need a high cutoff (ENCUT=1000 here) because the stress response is sensitive to basis completeness."
    },
    "soc": {
      "kind": "calc",
      "qvasp": "-band",
      "kpoints": "-k 0.03",
      "overrides": {
        "LSORBIT": true,
        "LMAXMIX": 4,
        "LORBIT": 11,
        "ISPIN": 2
      },
      "requires": [
        "POSCAR",
        "POTCAR",
        "MAGMOM"
      ],
      "produces": [
        "EIGENVAL",
        "OUTCAR"
      ],
      "gate": {
        "type": "file_present",
        "file": "EIGENVAL"
      },
      "note": "Non-collinear run: needs a magnetic species and an explicit MAGMOM in the INCAR."
    },
    "md": {
      "kind": "calc",
      "qvasp": "-md",
      "kpoints": "-k 0.04",
      "overrides": {
        "IBRION": 0,
        "NSW": 1000,
        "POTIM": 1.0,
        "TEBEG": 300,
        "TEEND": 300
      },
      "requires": [
        "POSCAR",
        "POTCAR"
      ],
      "produces": [
        "XDATCAR",
        "OSZICAR"
      ],
      "gate": {
        "type": "file_present",
        "file": "OSZICAR"
      },
      "note": "NVE/NVT sampling. The first ~2 ps are equilibration and must not enter the averages."
    },
    "transport": {
      "kind": "calc",
      "qvasp": "-optics",
      "kpoints": "-k 0.02",
      "overrides": {
        "LOPTICS": true,
        "NEDOS": 2000,
        "CSHIFT": 0.1,
        "ISMEAR": -5
      },
      "requires": [
        "POSCAR",
        "POTCAR"
      ],
      "produces": [
        "vasprun.xml"
      ],
      "gate": {
        "type": "file_present",
        "file": "vasprun.xml"
      },
      "note": "Optical matrix elements need a dense k-mesh and enough empty bands (NBANDS ~ 1.5x)."
    },
    "post": {
      "kind": "post",
      "qvasp": null,
      "requires": [],
      "produces": [],
      "gate": null,
      "note": "A qvasp post-processing command run on files copied from earlier stages."
    }
  }
}
