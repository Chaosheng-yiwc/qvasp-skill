{
    "name":  "qvasp-skill",
    "version":  "1.5.0",
    "description":  "qvasp toolkit for DeepSeek Harness: 88-command VASP reference skill + MCP server (18 tools) for task analysis, result analysis, error diagnosis, and standard workflows",
    "license":  "MIT",
    "author":  {
                   "name":  "Wencai Yi",
                   "email":  "yiwc@qfnu.edu.cn",
                   "url":  "https://qvasp.com"
               },
    "contributors":  [
                         {
                             "name":  "Wencai Yi",
                             "affiliation":  "Qufu Normal University"
                         }
                     ],
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/Chaosheng-yiwc/qvasp-skill.git"
                   },
    "keywords":  [
                     "dsh-plugin",
                     "qvasp",
                     "vasp",
                     "dft",
                     "materials-science",
                     "computational-physics",
                     "mcp",
                     "skill"
                 ],
    "type":  "module",
    "main":  "index.js",
    "exports":  {
                    ".":  "./index.js",
                    "./package.json":  "./package.json",
                    "./locale/*.json":  "./locale/*.json",
                    "./icon":  "./icon.svg"
                },
    "files":  [
                  "index.js",
                  "cordis.patch.yml",
                  "locale/*.json",
                  "docs",
                  "icon.svg",
                  "skills",
                  "server/*.py",
                  "server/*.json",
                  "server/*.md",
                  "server/analysis/*.py",
                  "server/reference/*.json",
                  "server/workflows/*.json",
                  "!server/**/__pycache__",
                  "tools/preflight_fixtures.py",
                  "LICENSE",
                  "README.md",
                  "assets",
                  "screenshots.json"
              ],
    "engines":  {
                    "node":  "\u003e=18"
                },
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           }
            }
}